# Copie este arquivo para ".env" e preencha

# Provedor de IA gratuita: "groq" (padrão) ou "gemini"
AI_PROVIDER=groq

# Chave do Groq (crie gratuitamente em console.groq.com -> API Keys)
GROQ_API_KEY=gsk_sua-chave-aqui

# OU, se preferir usar o Gemini (crie em aistudio.google.com -> Get API Key)
# GEMINI_API_KEY=sua-chave-aqui

# Opcional: modelo específico (padrões: openai/gpt-oss-120b no Groq, gemini-2.5-flash no Gemini)
# Consulte a lista atual em console.groq.com/docs/models — o Groq aposenta modelos com frequência
# AI_MODEL=

# Porta do servidor (padrão: 3000)
PORT=3000
